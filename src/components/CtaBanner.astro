---
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  button: string;
  href: string;
}

const { title, text, button, href } = Astro.props;
---

<section class="container-page">
  <div class="relative overflow-hidden rounded-3xl bg-brand-700 px-6 py-12 text-white sm:px-12">
    <div class="pointer-events-none absolute -end-16 -top-16 size-64 rounded-full bg-brand-500/40 blur-2xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-24 start-1/3 size-72 rounded-full bg-accent-400/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl space-y-3">
        <h2 class="text-3xl font-semibold">{title}</h2>
        <p class="text-white/80">{text}</p>
      </div>
      <a href={href} class="btn-accent shrink-0 px-6 py-3 text-base">
        {button}
        <Icon name="arrowRight" class="size-4 rtl:-scale-x-100" />
      </a>
    </div>
  </div>
</section>
