---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../config/site';
import { categories, categoryIcons, featuredCalculators, productMeta } from '../../data/catalog';
import { getDictionary, localeStaticPaths, localizePath, type Locale } from '../../i18n';
import { getProductsByCategory } from '../../lib/content';
import { formatCurrency } from '../../lib/format';
import { photo } from '../../lib/photos';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getDictionary(locale);
const h = t.home;
const byCategory = await getProductsByCategory(locale);
const contactHref = localizePath(locale, 'contact');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'InsuranceAgency',
  name: site.brand,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Vancouver', addressRegion: 'BC', addressCountry: 'CA' },
  areaServed: 'CA',
  knowsLanguage: ['en', 'fr', 'fa'],
};
const whyIcons = ['scale', 'badgeCheck', 'messageCircle', 'clock'] as const;
---

<BaseLayout locale={locale} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 -top-40 -z-10 h-[36rem] bg-[radial-gradient(60%_60%_at_70%_30%,var(--color-brand-100),transparent_70%)]" aria-hidden="true"></div>
    <div class="container-page grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-24">
      <div class="space-y-7">
        <p class="eyebrow inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 shadow-sm">
          <Icon name="badgeCheck" class="size-4" />{h.hero.eyebrow}
        </p>
        <h1 class="text-4xl leading-[1.08] font-semibold sm:text-5xl lg:text-6xl">{h.hero.title}</h1>
        <p class="max-w-xl text-lg leading-relaxed text-ink-soft">{h.hero.subtitle}</p>
        <div class="flex flex-wrap gap-3">
          <a href={contactHref} class="btn-primary px-6 py-3 text-base">
            {h.hero.primaryCta}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" />
          </a>
          <a href={localizePath(locale, 'calculators')} class="btn-ghost px-6 py-3 text-base">
            <Icon name="calculator" class="size-4" />{h.hero.secondaryCta}
          </a>
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 pt-2 text-sm text-ink-soft">
          {h.hero.trust.map((item) => (
            <li class="inline-flex items-center gap-2"><Icon name="check" class="size-4 text-brand-600" strokeWidth={2.5} />{item}</li>
          ))}
        </ul>
      </div>

      <!-- Photo with a floating illustrative coverage summary -->
      <div class="relative mx-auto w-full max-w-lg pb-16 lg:pb-10">
        <div class="absolute -inset-3 -z-10 rotate-2 rounded-[2rem] bg-accent-100" aria-hidden="true"></div>
        <Image
          src={photo('home-hero')}
          alt={t.photos['home-hero']}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 512px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl"
        />
        <div class="absolute end-4 bottom-0 w-64 rounded-2xl border border-line bg-white p-4 shadow-xl sm:-end-6 lg:-bottom-6" aria-hidden="true">
          <div class="flex items-center justify-between gap-2">
            <p class="text-xs font-semibold text-ink-soft">{t.calc.items['life-insurance-needs'].results.headline}</p>
            <Icon name="shield" class="size-4 text-brand-600" />
          </div>
          <p class="mt-1 font-display text-2xl font-semibold tabular-nums">{formatCurrency(locale, 850000)}</p>
          <div class="mt-3 space-y-2">
            {[72, 48, 22].map((pct) => (
              <div class="h-1.5 rounded-full bg-sand"><div class="h-1.5 rounded-full bg-brand-500" style={`width:${pct}%`}></div></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="container-page py-16" aria-labelledby="cat-title">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading id="cat-title" eyebrow={h.categories.eyebrow} title={h.categories.title} subtitle={h.categories.subtitle} />
      <a href={localizePath(locale, 'insurance')} class="btn-ghost shrink-0">{h.categories.viewAll}</a>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {categories.map((c) => (
        <div class="card flex flex-col overflow-hidden p-0">
          <div class="relative">
            <Image
              src={photo(`category-${c}`)}
              alt={t.photos[`category-${c}`]}
              widths={[400, 640, 800]}
              sizes="(min-width: 1024px) 360px, 100vw"
              class="aspect-[16/10] w-full object-cover"
            />
            <span class="absolute start-6 -bottom-6 flex size-12 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-lg ring-4 ring-white">
              <Icon name={categoryIcons[c]} class="size-6" />
            </span>
          </div>
          <div class="flex flex-1 flex-col p-6 pt-10">
          <h3 class="text-2xl font-semibold">{t.categories[c].name}</h3>
          <p class="mt-2 text-ink-soft">{t.categories[c].description}</p>
          <ul class="mt-5 flex-1 space-y-1 border-t border-line pt-4">
            {byCategory[c].map((p) => (
              <li>
                <a href={localizePath(locale, `insurance/${p.slug}`)} class="group flex items-center justify-between gap-3 rounded-lg py-2 text-sm font-medium hover:text-brand-700">
                  <span class="inline-flex items-center gap-2.5">
                    <Icon name={productMeta[p.slug].icon} class="size-4 text-brand-500" />{p.data.title}
                  </span>
                  <Icon name="arrowRight" class="size-4 text-ink-soft/50 transition group-hover:translate-x-0.5 group-hover:text-brand-600 rtl:-scale-x-100" />
                </a>
              </li>
            ))}
          </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Calculators -->
  <section class="bg-white py-16" aria-labelledby="calc-title">
    <div class="container-page">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeading id="calc-title" eyebrow={h.calculators.eyebrow} title={h.calculators.title} subtitle={h.calculators.subtitle} />
        <a href={localizePath(locale, 'calculators')} class="btn-ghost shrink-0">{h.calculators.viewAll}</a>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {featuredCalculators.map((slug) => <CalculatorCard slug={slug} locale={locale} />)}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="container-page py-16" aria-labelledby="how-title">
    <SectionHeading id="how-title" eyebrow={h.how.eyebrow} title={h.how.title} align="center" />
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {h.how.steps.map((step, i) => (
        <li class="relative card">
          <span class="flex size-10 items-center justify-center rounded-full bg-accent-400 font-display text-lg font-semibold">{i + 1}</span>
          <h3 class="mt-4 text-xl font-semibold">{step.title}</h3>
          <p class="mt-2 text-ink-soft">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Why us -->
  <section class="bg-ink py-16 text-white" aria-labelledby="why-title">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="space-y-3">
        <p class="eyebrow text-accent-300">{h.why.eyebrow}</p>
        <h2 id="why-title" class="text-3xl font-semibold sm:text-4xl">{h.why.title}</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2">
        {h.why.items.map((item, i) => (
          <div class="space-y-2">
            <Icon name={whyIcons[i % whyIcons.length]} class="size-6 text-accent-300" />
            <h3 class="font-sans text-lg font-semibold">{item.title}</h3>
            <p class="text-white/70">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="container-page py-16" aria-labelledby="test-title">
    <SectionHeading id="test-title" eyebrow={h.testimonials.eyebrow} title={h.testimonials.title} align="center" />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {h.testimonials.items.map((item) => (
        <figure class="card flex flex-col gap-4">
          <Icon name="quote" class="size-7 text-accent-400" />
          <blockquote class="flex-1 leading-relaxed text-ink">{item.quote}</blockquote>
          <figcaption class="text-sm font-semibold text-ink-soft">{item.name}</figcaption>
        </figure>
      ))}
    </div>
    <!-- TODO: remove once real testimonials are added. -->
    <p class="mt-4 text-center text-xs text-ink-soft/70">{h.testimonials.note}</p>
  </section>

  <CtaBanner title={h.cta.title} text={h.cta.text} button={h.cta.button} href={contactHref} />
</BaseLayout>
