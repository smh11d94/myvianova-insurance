---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, isLocale, localizePath, stripBase, type Locale } from '../i18n';

// Static 404 page, rendered in English (GitHub Pages serves one 404.html for every missing URL).
const segment = stripBase(Astro.url.pathname).split('/')[1];
const locale: Locale = isLocale(segment) ? segment : 'en';
const t = getDictionary(locale);
---

<BaseLayout locale={locale} title={t.notFound.title}>
  <section class="container-page flex flex-col items-center py-24 text-center">
    <p class="font-display text-7xl font-semibold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-semibold">{t.notFound.title}</h1>
    <p class="mt-3 text-ink-soft">{t.notFound.text}</p>
    <a href={localizePath(locale)} class="btn-primary mt-8">{t.notFound.home}</a>
  </section>
</BaseLayout>
